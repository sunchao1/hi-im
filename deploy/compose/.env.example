# Copy to deploy/compose/.env and adjust for local dev.
# Do NOT commit real credentials.

# Hub image (pull) or build from sibling checkout
HIIM_HUB_IMAGE=ghcr.io/sunchao1/hi-im-core/hub:v0.1.0
HIIM_HUB_BUILD_CONTEXT=../hi-im-core
HIIM_BASE_IMAGE=ubuntu:22.04

# Hub auth (must match hub command-line flags)
HIIM_AUTH_USER=proxy
HIIM_AUTH_PASS=proxy

# Host port mappings (optional; change if defaults conflict with hi-im-core dev stack)
HIIM_FORWARD_HOST_PORT=28888
HIIM_BACKEND_HOST_PORT=28889
HIIM_HEALTH_HOST_PORT=18080

# Stub / smoke NIDs and bench command (hex)
HIIM_CONSUMER_NID=40001
HIIM_PRODUCER_NID=50001
HIIM_BENCH_CMD=0x030B

# Smoke timeout seconds
HIIM_SMOKE_TIMEOUT=30

# --- M6 group chat (dual gateway) ---
# Sibling checkout root: ../ = parent of hi-im (hi-im-api, hi-im-core, hi-im-gateway, …)
HIIM_BUILD_ROOT=..

# Image tag for locally built M6 services
HIIM_M6_TAG=local

# Host ports (change if 18080/28080 conflict with other stacks)
HIIM_GATEWAY1_HTTP_PORT=28080
HIIM_GATEWAY2_HTTP_PORT=28081
# Demo web host port. Use 8089 if beehive-demo-web already occupies 8088.
HIIM_DEMO_WEB_PORT=8088
HIIM_MYSQL_ROOT_PASSWORD=hiim
